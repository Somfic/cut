{
  "name": "cut-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "glow": "cd node_modules/glow && bun install --ignore-scripts && bunx svelte-kit sync && bunx svelte-package",
    "postinstall": "bun run glow"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "glow": "github:somfic/glow"
  }
}
